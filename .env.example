# ============================================================
# CareSync — Doctor Appointment Management System
# Environment Configuration
# ============================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.

# ----------------------------------------------------------------
# DATABASE
# ----------------------------------------------------------------
# Option A: Supabase PostgreSQL (Session Pooler)
# Paste your Supabase "Session Pooler" connection string here.
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
#
# Option B: Local SQLite fallback (for offline dev only)
# DATABASE_URL=sqlite:///./doctor_appointments.db

DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-DB-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# ----------------------------------------------------------------
# JWT AUTHENTICATION
# ----------------------------------------------------------------
# Use a strong random string in production (e.g. openssl rand -hex 32)
SECRET_KEY=change-me-to-a-long-random-secret-key-in-production

# ----------------------------------------------------------------
# SUPABASE (Optional - only needed if using Supabase Auth directly)
# ----------------------------------------------------------------
# SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
# SUPABASE_ANON_KEY=your-anon-key-here
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here   # NEVER expose this in frontend

# ----------------------------------------------------------------
# FRONTEND
# ----------------------------------------------------------------
# NEXT_PUBLIC_API_URL=http://localhost:8000/api
