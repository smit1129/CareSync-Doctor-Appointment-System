            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Jane Foster\",\n  \"email\": \"jane.foster@example.com\",\n  \"phone\": \"+1-555-0301\",\n  \"password\": \"Password@123\",\n  \"role\": \"patient\"\n}"
